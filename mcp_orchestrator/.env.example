# Copia este archivo como .env (los instaladores lo hacen por ti). Lo que quede vacío usa el valor por defecto.

# ===== Carpetas (enrutamiento) =====
# Trabajo: proyectos laborales (OpenCode solo actúa dentro). Por defecto ~/workspaces
# Ejemplos: Windows D:\workspaces · macOS /Users/tu-usuario/workspaces
TRABAJO_DIR=
# Personal y universidad (Antigravity solo escribe dentro). Por defecto ~/personal y ~/universidad
PERSONAL_DIR=
UNIVERSIDAD_DIR=
# Otras carpetas propias que también van a Antigravity (coma). Por defecto la del orquestador
OTRAS_CARPETAS_PERSONALES=
# Logs, checklists y aprendizajes. Por defecto dentro del repositorio
LOGS_DIR=
TAREAS_DIR=

# ===== TRABAJO: OpenCode =====
# Ruta al binario de OpenCode, o "opencode" si está en el PATH
OPENCODE_CLI_PATH=opencode
# Por defecto ~/.config/opencode/opencode.jsonc (o .json)
OPENCODE_CONFIG_PATH=
OPENCODE_TIMEOUT_SECONDS=1800
# Servidor OpenCode persistente (se inicia solo). Si cambias la config de OpenCode, ciérralo para que recargue.
OPENCODE_SERVER_URL=http://127.0.0.1:4096
# Contraseña del servidor (el instalador la genera al azar)
OPENCODE_SERVER_PASSWORD=
# 1 = abrir una ventana/terminal por tarea; 0 = sin ventanas
MOSTRAR_CONSOLA=1
# Proveedor definido en tu config de OpenCode y modelo por defecto
INNTI_PROVIDER=litellm-proxy
INNTI_DEFAULT_MODEL=
# Solo como respaldo para listar modelos (OpenCode usa su propia config)
INNTI_BASE_URL=
INNTI_API_KEY=

# ===== PERSONAL: Antigravity =====
# agy = CLI oficial de Antigravity con tu cuenta (recomendado) · api = respaldo con la API de Gemini (solo texto)
ANTIGRAVITY_MODE=agy
# Por defecto ~/.gemini/bin/agy (agy.exe en Windows)
ANTIGRAVITY_CLI_PATH=
# Modelos disponibles: agy models
ANTIGRAVITY_AGY_MODEL=gemini-3.8-flash-medium
ANTIGRAVITY_AGY_FALLBACK=gemini-3.8-flash-low
# Si un modelo llega a su límite de uso se pasa al siguiente de esta lista (de más a menos capaz)
ANTIGRAVITY_CADENA=gemini-4-argon-high,gemini-4-argon-medium,gemini-3.8-flash-medium,gemini-3.8-flash-low
# tui = la tarea corre en la ventana del CLI oficial · visor = agy sin ventana + visor propio
ANTIGRAVITY_VISTA=tui
# 0 = solo crea/edita archivos (seguro) · 1 = también ejecuta comandos sin pedir permiso (riesgoso)
ANTIGRAVITY_SKIP_PERMISSIONS=0
ANTIGRAVITY_TIMEOUT_SECONDS=900
# --- Respaldo modo api ---
ANTIGRAVITY_API_KEY=
ANTIGRAVITY_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
ANTIGRAVITY_MODEL=gemini-3.5-flash
ANTIGRAVITY_FALLBACK_MODELS=gemini-flash-latest,gemini-3.1-flash-lite

# ===== Control =====
# URL del artefacto "panel" que Claude sincroniza (ver README)
PANEL_URL=
# Rondas de corrección permitidas por ítem antes de consultar al usuario
MAX_RONDAS_CORRECCION=2
# Días que guarda el panel
PANEL_DIAS=120
# Tabla de precios local (ver precios.example.json)
PRECIOS_FILE=

# ===== Grupo 2: aislamiento y presupuesto =====
# 1 = en repos git, OpenCode trabaja en un worktree con rama orq/… (tu repo no se toca hasta integrar)
AISLAR_TRABAJO=1
# Presupuesto de Innti en US$ (vacío = sin límite). Avisa desde el % indicado y frena al llegar al límite.
PRESUPUESTO_DIA_USD=
PRESUPUESTO_MES_USD=
PRESUPUESTO_AVISO_PCT=80
# Tiempo máximo por comando de verificación (tests/lint)
VERIFICACION_TIMEOUT_SECONDS=900

# Máximo de caracteres que se devuelven a Claude por respuesta
MAX_RETURN_CHARS=1500
